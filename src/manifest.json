{
  "manifest_version": 3,
  "name": "DocPort — Docs to Word Exporter",
  "short_name": "DocPort",
  "version": "1.0.0",
  "author": "quanghuytran.hust@gmail.com",
  "description": "Export any Google Docs page — including view-only — to a properly formatted .docx file. Preserves headings, bold, italic, tables, lists, images, and hyperlinks.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DocPort — Export to .docx",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
